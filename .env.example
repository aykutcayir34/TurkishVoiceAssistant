# Sohbet yapılandırma şablonu. Kopyalayın: cp .env.example .env
# Tüm değişkenler SOHBET_ önekiyle okunur.

# --- Backend seçimi ---
# Varsayılanlar mock/hafif -> CPU'da çalışır. Gerçek modeller için değiştirin.
SOHBET_VAD_BACKEND=energy          # energy | silero
SOHBET_STT_BACKEND=mock            # mock | faster_whisper
SOHBET_LLM_BACKEND=mock            # mock | vllm
SOHBET_EMBEDDING_BACKEND=hash      # hash | bge_m3
SOHBET_VECTORDB_BACKEND=memory     # memory | qdrant
SOHBET_TTS_BACKEND=mock            # mock | xtts | piper

# --- Gerçek (GPU) yığın örneği ---
# SOHBET_VAD_BACKEND=silero
# SOHBET_STT_BACKEND=faster_whisper
# SOHBET_LLM_BACKEND=vllm
# SOHBET_EMBEDDING_BACKEND=bge_m3
# SOHBET_VECTORDB_BACKEND=qdrant
# SOHBET_TTS_BACKEND=xtts

# --- STT (faster-whisper) ---
SOHBET_WHISPER_MODEL=large-v3
SOHBET_WHISPER_DEVICE=cuda
SOHBET_WHISPER_COMPUTE_TYPE=float16
SOHBET_STT_LANGUAGE=tr

# --- LLM (vLLM OpenAI-uyumlu endpoint) ---
SOHBET_LLM_BASE_URL=http://vllm:8000/v1
SOHBET_LLM_API_KEY=EMPTY
SOHBET_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
SOHBET_LLM_TEMPERATURE=0.7
SOHBET_LLM_MAX_TOKENS=512

# --- Embedding (bge-m3) ---
SOHBET_EMBEDDING_MODEL=BAAI/bge-m3
SOHBET_EMBEDDING_DIM=1024
SOHBET_EMBEDDING_DEVICE=cuda

# --- Vektör DB (Qdrant) ---
SOHBET_QDRANT_URL=http://qdrant:6333
SOHBET_QDRANT_COLLECTION=sohbet_kb

# --- TTS ---
SOHBET_XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
SOHBET_TTS_SPEAKER_WAV=data/voices/tr_reference.wav
SOHBET_TTS_LANGUAGE=tr
SOHBET_PIPER_MODEL=tr_TR-dfki-medium

# --- RAG ---
SOHBET_CHUNK_SIZE=700
SOHBET_CHUNK_OVERLAP=100
SOHBET_RETRIEVAL_TOP_K=5

# --- Sunucu ---
SOHBET_HOST=0.0.0.0
SOHBET_PORT=8080
SOHBET_LOG_LEVEL=INFO
